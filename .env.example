AI_PCB_ENGINE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 兼容 API：自定义地址须使用 HTTPS 并以 /v1 结尾，服务须支持 Responses API。
# 更换目标时使用新目标的密钥；不要提交含密钥的 .env。
# OPENAI_MODEL 按目标平台的模型权限配置；不要将空模型项直接启用。
# OPENAI_MODEL=
# 其余可选参数及范围见 docs/API_COMPATIBILITY.md。
AI_PCB_ADDR=127.0.0.1:3000
AI_PCB_DATA_DIR=data/projects
